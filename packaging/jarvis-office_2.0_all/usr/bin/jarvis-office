#!/bin/bash
# Jarvis Office Starter
# Öffnet Jarvis Office im Standard-Browser

APP_DIR="/usr/share/jarvis-office"
INDEX="$APP_DIR/index.html"

if [ ! -f "$INDEX" ]; then
    echo "Fehler: Jarvis Office Dateien nicht gefunden unter $APP_DIR" >&2
    exit 1
fi

# Browser-Reihenfolge: Chromium-App-Modus bevorzugt (kein Browser-Chrome = sauberes Fenster)
launch_chromium_app() {
    local bin="$1"
    local extra_flags=""

    # Wayland-Unterstützung: automatisch erkennen
    if [ "$XDG_SESSION_TYPE" = "wayland" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        extra_flags="--ozone-platform=wayland --enable-features=UseOzonePlatform"
    fi

    "$bin" --app="file://$INDEX" \
           --window-size=1400,900 \
           --user-data-dir="$HOME/.config/jarvis-office" \
           --no-first-run \
           --disable-translate \
           --noerrdialogs \
           $extra_flags \
           2>/dev/null &
}

if command -v chromium-browser >/dev/null 2>&1; then
    launch_chromium_app chromium-browser
elif command -v chromium >/dev/null 2>&1; then
    launch_chromium_app chromium
elif command -v google-chrome-stable >/dev/null 2>&1; then
    launch_chromium_app google-chrome-stable
elif command -v google-chrome >/dev/null 2>&1; then
    launch_chromium_app google-chrome
elif command -v firefox >/dev/null 2>&1; then
    firefox "file://$INDEX" 2>/dev/null &
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "file://$INDEX" 2>/dev/null &
else
    echo "Kein Browser gefunden. Bitte öffne manuell: file://$INDEX" >&2
    exit 1
fi

exit 0
