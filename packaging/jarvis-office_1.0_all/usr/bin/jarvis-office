#!/bin/bash
APP_DIR="/usr/share/jarvis-office"
INDEX="$APP_DIR/index.html"

if [ ! -f "$INDEX" ]; then
    echo "Fehler: $INDEX nicht gefunden" >&2
    exit 1
fi

launch_chromium_app() {
    local bin="$1"
    "$bin" --app="file://$INDEX" \
           --window-size=1400,900 \
           --user-data-dir="$HOME/.config/jarvis-office" \
           --no-first-run \
           --disable-translate \
           --noerrdialogs \
           2>/dev/null &
}

if command -v chromium-browser >/dev/null 2>&1; then
    launch_chromium_app chromium-browser
elif command -v chromium >/dev/null 2>&1; then
    launch_chromium_app chromium
elif command -v google-chrome-stable >/dev/null 2>&1; then
    launch_chromium_app google-chrome-stable
elif command -v google-chrome >/dev/null 2>&1; then
    launch_chromium_app google-chrome
elif command -v opera >/dev/null 2>&1; then
    opera "file://$INDEX" 2>/dev/null &
elif command -v firefox >/dev/null 2>&1; then
    firefox "file://$INDEX" 2>/dev/null &
elif [ -x "/opt/pw-browsers/chromium" ]; then
    launch_chromium_app /opt/pw-browsers/chromium
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "file://$INDEX" 2>/dev/null &
else
    echo "Kein Browser gefunden." >&2
    exit 1
fi

exit 0
