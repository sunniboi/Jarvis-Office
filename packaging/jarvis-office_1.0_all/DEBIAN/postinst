#!/bin/bash
set -e

# Berechtigungen setzen
chmod 755 /usr/bin/jarvis-office
chmod -R 644 /usr/share/jarvis-office/
find /usr/share/jarvis-office -type d -exec chmod 755 {} \;
chmod 644 /usr/share/applications/jarvis-office.desktop

# Desktop-Datenbank aktualisieren
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications/ || true
fi

# Icon-Cache aktualisieren
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor/ 2>/dev/null || true
fi

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║        Jarvis Office v1.0 installiert        ║"
echo "║                                              ║"
echo "║  Starten:  jarvis-office                     ║"
echo "║  oder über das Anwendungsmenü (Büro)         ║"
echo "╚══════════════════════════════════════════════╝"
echo ""

exit 0
