# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# ".env" niemals veröffentlichen (steht in .gitignore).

PORT=3000

# Lange, zufällige Zeichenkette zum Signieren der Login-Sitzungen.
# Wenn leer, wird beim ersten Start automatisch eine erzeugt (data/.session-secret).
SESSION_SECRET=

# PayPal: zuerst mit den Sandbox-Zugangsdaten testen!
# Zugangsdaten findest du im PayPal-Developer-Dashboard (developer.paypal.com).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Auf dem echten Server: NODE_ENV=production (setzt Cookies auf "Secure")
NODE_ENV=development
